output "external_volume_name" {
  description = "External volume name. The dbt Iceberg models refer to it"
  value       = snowflake_external_volume.this.name
}

# IAM user and external ID generated by Snowflake. The aws layer uses them in the IAM role trust policy
output "storage_aws_iam_user_arn" {
  description = "ARN of the IAM user generated by Snowflake"
  value       = local.s3_location.storage_aws_iam_user_arn
}

output "storage_aws_external_id" {
  description = "External ID generated by Snowflake"
  value       = local.s3_location.storage_aws_external_id
}
