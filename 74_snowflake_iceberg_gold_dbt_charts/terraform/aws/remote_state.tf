# Reads the snow-infra outputs: resource names, the IAM user and external ID generated by Snowflake, and the Lambda environment values
data "terraform_remote_state" "infra" {
  backend = "local"

  config = {
    path = "${path.module}/../snow-infra/terraform.tfstate"
  }
}

locals {
  infra = data.terraform_remote_state.infra.outputs
}
