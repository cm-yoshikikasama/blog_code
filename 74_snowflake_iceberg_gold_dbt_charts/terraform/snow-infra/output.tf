# The aws layer reads these outputs with terraform_remote_state

output "prefix" {
  description = "Prefix of AWS resource names"
  value       = local.prefix
}

output "gold_bucket_name" {
  description = "Bucket for the gold Iceberg files"
  value       = local.gold_bucket_name
}

output "html_bucket_name" {
  description = "Bucket for the dashboard HTML"
  value       = local.html_bucket_name
}

output "gold_role_name" {
  description = "IAM role name used by the external volume"
  value       = local.gold_role_name
}

output "lambda_role_name" {
  description = "Lambda execution role name. Must match the ARN registered on the service user"
  value       = local.lambda_role_name
}

output "gold_storage_aws_iam_user_arn" {
  description = "ARN of the IAM user generated by the external volume. Used in the gold IAM role trust policy"
  value       = module.external_volume.storage_aws_iam_user_arn
}

output "gold_storage_aws_external_id" {
  description = "External ID generated by the external volume. Used in the gold IAM role trust policy"
  value       = module.external_volume.storage_aws_external_id
}

# Lambda environment values
output "horizon_url" {
  description = "URL of the Horizon Iceberg REST catalog"
  # "_" in the host name does not match the TLS certificate, so replace it with "-"
  value = "https://${lower(replace(var.snowflake_account_identifier, "_", "-"))}.snowflakecomputing.com/polaris/api/catalog"
}

output "database_name" {
  description = "Snowflake database attached as the Horizon catalog"
  value       = module.database.database_name
}

output "reader_role_name" {
  description = "Role used to get the Horizon access token"
  value       = module.reader_role.role_name
}
